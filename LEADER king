<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Abdoul Disign</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f2f2f2;
      margin: 0;
      padding: 20px;
      text-align: center;
    }

    .app {
      max-width: 500px;
      margin: auto;
      background: white;
      padding: 25px;
      border-radius: 20px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.15);
    }

    h1 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    p {
      color: #555;
    }

    input, textarea {
      width: 90%;
      padding: 13px;
      margin: 8px 0;
      border: 1px solid #ccc;
      border-radius: 10px;
      font-size: 16px;
    }

    button {
      width: 95%;
      padding: 15px;
      margin-top: 15px;
      border: none;
      border-radius: 12px;
      background: #111;
      color: white;
      font-size: 17px;
      font-weight: bold;
    }

    button:hover {
      background: #333;
    }
  </style>
</head>

<body>

  <div class="app">

    <h1>ABDOUL DISIGN</h1>

    <p>Bienvenue dans mon application de design.</p>

    <input type="text" id="nom" placeholder="Votre nom">

    <input type="text" id="service" placeholder="Service demandé">

    <textarea id="message" placeholder="Décrivez votre commande"></textarea>

    <button onclick="envoyerCommande()">
      Envoyer ma commande
    </button>

  </div>

  <script>
    function envoyerCommande() {

      let nom = document.getElementById("nom").value;
      let service = document.getElementById("service").value;
      let message = document.getElementById("message").value;

      let texte =
        "Bonjour Abdoul Disign,%0A%0A" +
        "Nom : " + nom + "%0A" +
        "Service : " + service + "%0A" +
        "Commande : " + message;

      window.location.href =
        "https://wa.me/243859352195?text=" + texte;
    }
  </script>

</body>
</html>
